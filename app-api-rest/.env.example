# Copia este archivo como .env y cambia los valores.

# Puerto del servidor
PORT=3000

# Rutas opcionales (por defecto: ./library.sqlite y ./uploads)
# DB_PATH=./library.sqlite
# UPLOADS_DIR=./uploads

# Secreto para firmar los tokens de sesión. Usa un texto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Duración de la sesión del panel de administración (horas)
TOKEN_TTL_HOURS=8

# Usuario administrador que se crea la primera vez que arranca el servidor
# (solo si todavía no existe ningún usuario). Para cambiar la contraseña después:
#   npm run set-password -- admin nuevaContraseña
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
